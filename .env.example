DB_PORT=5432
API_PORT=3000
FRONTEND_PORT=5173
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Used when running the API locally; docker compose sets its own.
DATABASE_URL=postgres://imgtagr:imgtagr@localhost:${DB_PORT}/imgtagr
AWS_ENDPOINT=http://localhost:${S3_PORT}
AWS_ALLOW_HTTP=true
AWS_REGION=us-east-1
AWS_BUCKET=imgtagr
AWS_ACCESS_KEY_ID=imgtagr
AWS_SECRET_ACCESS_KEY=imgtagr-secret

# Host port Postgres is exposed on (container still listens on 5432)
DB_PORT=5432

# Used by the API when run locally (docker compose sets its own)
DATABASE_URL=postgres://imgtagr:imgtagr@localhost:${DB_PORT}/imgtagr

# Vite dev server port
FRONTEND_PORT=5173

# API port (host port in Docker, listen port when run locally)
API_PORT=3000
